# Copy to .env and set the server broker password from gen-passwd.sh.
MQTT_USER=smarthouse-server
MQTT_PASS=change-me
MQTT_TOPIC_PREFIX=smarthouse
RETENTION_DAYS=180
# Host ports (change if 8883/8080 are already in use).
MQTT_PORT=8883
HTTP_PORT=8080
# Comma-separated origins for the future dashboard dev server.
CORS_ORIGINS=http://localhost:5173
